# Sao chép thành .env (KHÔNG commit .env). Server đọc file này lúc khởi động.
# Provider: anthropic (Claude, khuyến nghị cho demo) | ollama (local) | openrouter | mock (smoke test)
AI_PROVIDER=anthropic

# --- Anthropic (cần: cd codebase/server && npm install) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high — medium đủ cho giải thích ≤120 từ và độ trễ demo thấp
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=4096

# --- Ollama local ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Chung ---
AI_MODEL=
AI_TIMEOUT_MS=60000
AI_RETRIES=2
RETRIEVAL_TOP_K=3
# Increase this to cite fewer, higher-confidence transcript chunks.
RETRIEVAL_MIN_SCORE=5
RETRIEVAL_MIN_CORE_TERMS=2
PORT=8787
