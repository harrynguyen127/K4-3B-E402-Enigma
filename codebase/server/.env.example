# Sao chép thành .env (KHÔNG commit .env). Server đọc file này lúc khởi động.
# Mặc định chạy model 7B hoàn toàn local qua Ollama. Smoke/offline: mock.
AI_PROVIDER=ollama
AI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_TIMEOUT_MS=120000
AI_RETRIES=0
RETRIEVAL_TOP_K=3
# Increase this to cite fewer, higher-confidence transcript chunks.
RETRIEVAL_MIN_SCORE=5
RETRIEVAL_MIN_CORE_TERMS=2
PORT=8787
