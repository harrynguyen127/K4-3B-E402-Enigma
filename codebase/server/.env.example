# Sao chép thành .env (KHÔNG commit .env). Server đọc file này lúc khởi động.
# Provider mặc định lúc khởi động: anthropic (Claude) | gemini | ollama (local) | openrouter | mock (smoke test)
# Có thể đổi provider/model lúc chạy ở tab Tech của UI (không cần sửa file này); key luôn lấy từ file này.
AI_PROVIDER=gemini

# --- Anthropic (cần: cd codebase/server && npm install) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high — medium đủ cho giải thích ≤120 từ và độ trễ demo thấp
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=4096

# --- Google Gemini (key lấy ở https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=8192
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Ollama local ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Chung ---
AI_MODEL=
AI_TIMEOUT_MS=60000
AI_RETRIES=2
# Data pack transcript KHÔNG nằm trong repo. Trỏ tới bản cục bộ (dùng dấu / kể cả trên Windows).
# Bỏ trống: server tìm ở data/vlearn-pack/transcript (đã gitignore); không có thì retrieval tắt.
TRANSCRIPT_DIR=
RETRIEVAL_TOP_K=3
# Increase this to cite fewer, higher-confidence transcript chunks.
RETRIEVAL_MIN_SCORE=5
RETRIEVAL_MIN_CORE_TERMS=2
PORT=8787
